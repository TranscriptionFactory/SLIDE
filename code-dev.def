Bootstrap: docker
From: node:20-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        openssh-client \
        less \
        procps \
        ripgrep \
        bash \
        coreutils \
        findutils \
        sed \
        gawk \
        grep \
        diffutils \
        patch \
    && rm -rf /var/lib/apt/lists/*
